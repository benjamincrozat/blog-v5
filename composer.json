{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "benjamincrozat/blog-v5",
    "type": "project",
    "description": "The Laravel application for benjamincrozat.com.",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "algolia/algoliasearch-client-php": "^4.39",
        "andreiio/blade-iconoir": "^4.7",
        "blade-ui-kit/blade-heroicons": "^2.7",
        "coconutcraig/laravel-postmark": "^3.4",
        "embed/embed": "^4.4",
        "filament/filament": "^5.4",
        "knplabs/github-api": "^3.16",
        "lab404/laravel-impersonate": "^1.7.8",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.45",
        "laravel/scout": "^11.0",
        "laravel/socialite": "^5.25",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.32",
        "livewire/livewire": "^4.2",
        "openai-php/laravel": "^0.20",
        "sentry/sentry-laravel": "^4.20",
        "spatie/browsershot": "^5.2",
        "spatie/laravel-feed": "^4.5",
        "spatie/laravel-livewire-wizard": "^3.1",
        "spatie/laravel-sitemap": "^8.0",
        "tempest/highlight": "^2.17"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.1",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/pail": "^1.2",
        "laravel/pao": "^1.1.3",
        "laravel/pint": "^1.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "spatie/laravel-db-snapshots": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm ci --ignore-scripts",
            "npm run build"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
